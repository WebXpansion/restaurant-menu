<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= restaurant.name %></title>
  <link rel="stylesheet" href="/css/menu.css">
</head>

<body>

  <style>
    /* ======================
   LOADER
====================== */

#siteLoader {
  position: fixed;
  inset: 0;
  background: url('/images/fond-resto.webp') center/cover no-repeat;
  display: none; 
  align-items: center;
  justify-content: center;
  z-index: 9999;
  transition: opacity 0.8s ease, visibility 0.8s ease;
}


.loader-content {
  text-align: center;
  color: white;
}

.loader-logo {
  width: 120px;
  margin-bottom: 40px;
  opacity: 0;
  transform: translateY(20px);
  animation: fadeUp 0.8s ease forwards;
}

.loader-text {
  font-size: 28px;
  font-weight: 500;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.line {
  opacity: 0;
  filter: blur(10px);
  transform: translateY(20px);
}

.line-1 {
  animation: textReveal 0.8s ease forwards 0.6s;
}

.line-2 {
  animation: textReveal 0.8s ease forwards 1.1s;
}

/* Animations */

@keyframes textReveal {
  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Fade out */

#siteLoader.hide {
  opacity: 0;
  visibility: hidden;
}

  </style>

  <div id="siteLoader">
    <div class="loader-content">
      
      <img src="/icons/logo.webp" class="loader-logo" alt="Logo">
  
      <div class="loader-text">
        <span class="line line-1">Découvrez</span>
        <span class="line line-2">votre menu</span>
      </div>
  
    </div>
  </div>
  

  <div class="page-content">
    <%- body %>
  </div>

  <%- include("/public/partials/mobile-nav") %>



  <script>
    window.RESTAURANT_SLUG = "<%= restaurant.slug %>";
  </script>
<script>
  const loader = document.getElementById("siteLoader");

  const hasShown = sessionStorage.getItem("loaderShown");

  if (!hasShown) {
    loader.style.display = "flex";

    window.addEventListener("load", () => {
      setTimeout(() => {
        loader.classList.add("hide");
        sessionStorage.setItem("loaderShown", "true");
      }, 2200); // laisse le temps aux anims texte
    });

  } else {
    loader.remove(); // 🔥 beaucoup plus propre que display:none
  }
</script>



</body>
</html>
