<link rel="stylesheet" href="/css/restaurant.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">


<div class="body-restaurant">
  <section class="about-hero">
    <div class="about-slider">
      <% if (images && images.length) { %>
        <% images.forEach(img => { %>
          <div class="slide">
            <img 
              src="<%= img %>?f_auto,q_auto"
              loading="lazy"
              alt="Image restaurant"
            />
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

  <section class="about-content">
    <%
  const daysMap = {
    1: "Lundi",
    2: "Mardi",
    3: "Mercredi",
    4: "Jeudi",
    5: "Vendredi",
    6: "Samedi",
    7: "Dimanche"
  };
%>
    <h1><%= about.title || "" %></h1>




        <!-- HORAIRES -->
    <section class="info-section">

      <div class="info-header toggle-hours">
        <div class="info-left">
          <span class="icon-clock"></span>
          <span>Horaires</span>
        </div>
        <div class="arrow">⌄</div>
      </div>

      <div class="info-content hours-content">

        <% if (hours && hours.length) { %>
          
          <% hours.forEach(h => { %>
            <div class="hour-row">
              <div class="day">
                <%= daysMap[h.day_of_week] %>
              </div>
              <div class="times">
                <% if (h.open_time) { %>
                  <div>De <%= h.open_time %> à <%= h.close_time %></div>
                  <% if (h.second_open_time) { %>
                    <div>De <%= h.second_open_time %> à <%= h.second_close_time %></div>
                  <% } %>
                <% } else { %>
                  <div>Fermé</div>
                <% } %>
              </div>
            </div>
          <% }) %>
      
        <% } else { %>
      
          <div class="hour-row">
            <div class="day">Horaires non disponibles</div>
          </div>
      
        <% } %>
      
      </div>

    </section>

    <p><%= about.description || "" %></p>


    <!-- ADRESSE (section séparée) -->
    <section class="info-section address-section">

      <div class="info-header no-toggle">
        <div class="info-left">
          <span class="icon-location"></span>
          <span><%= restaurant.address || "Adresse non disponible" %></span>
        </div>
      </div>

    </section>



    <% if (showGoogleButton && googleReviewUrl) { %>
      <a href="<%= googleReviewUrl %>"
         target="_blank"
         rel="noopener noreferrer"
         class="google-review-btn">
    
        <!-- Google Icon SVG -->
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4"
            d="M23.49 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h6.45a5.52 5.52 0 01-2.4 3.63v3.02h3.88c2.27-2.09 3.56-5.18 3.56-8.68z"/>
          <path fill="#34A853"
            d="M12 24c3.24 0 5.96-1.07 7.95-2.91l-3.88-3.02c-1.08.73-2.46 1.17-4.07 1.17-3.13 0-5.78-2.11-6.73-4.95H1.28v3.11A11.99 11.99 0 0012 24z"/>
          <path fill="#FBBC05"
            d="M5.27 14.29a7.2 7.2 0 010-4.58V6.6H1.28a12 12 0 000 10.8l3.99-3.11z"/>
          <path fill="#EA4335"
            d="M12 4.75c1.76 0 3.34.61 4.59 1.81l3.44-3.44C17.96 1.07 15.24 0 12 0A12 12 0 001.28 6.6l3.99 3.11C6.22 6.86 8.87 4.75 12 4.75z"/>
        </svg>
    
        Laisser un avis Google
      </a>
    <% } %>
  </section>

  
</div>



<%- include("partials/mobile-nav", { activeTab }) %>


<script>
  window.UI = <%- JSON.stringify(ui) %>;
</script>

<script src="/js/menu-select.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const toggle = document.querySelector(".toggle-hours");

    if (!toggle) return;

    toggle.addEventListener("click", function () {
      const section = this.closest(".info-section");
      if (section) {
        section.classList.toggle("open");
      }
    });
  });
</script>