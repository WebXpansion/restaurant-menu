<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/css/carte-produit.css">
  <title><%= restaurant.name %></title>
<!-- Importmap Three.js -->
<script type="importmap">
    {
      "imports": {
        "three": "/vendor/three/three.module.js",
        "three/examples/jsm/": "/vendor/three/examples/jsm/"
      }
    }
    </script>
    
    
    

  <style>
body {
  font-family: system-ui;
  margin: 0;
  background: #f4f5f7;
}

/* conteneur global */
.container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 20px;
}

/* mobile */
@media (max-width: 768px) {
  .container {
    padding: 0px;
  }
}


    h1 {
      margin-bottom: 30px;
    }


    .grid {
      display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0px 16px 120px 16px;
    
}





   /* ======================
   LOADER
====================== */

#siteLoader {
  position: fixed;
  inset: 0;
  background: url('/images/fond-resto.webp') center/cover no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  transition: opacity 0.8s ease, visibility 0.8s ease;
}



.loader-content {
  text-align: center;
  color: white;
}

.loader-logo {
  width: 50px;
  margin-bottom: 40px;
  opacity: 0;
  transform: translateY(20px);
  animation: fadeUp 0.8s ease forwards;
}

.loader-text {
  font-size: 28px;
  font-weight: 500;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.line {
  opacity: 0;
  filter: blur(10px);
  transform: translateY(20px);
}

.line-1 {
  animation: textReveal 0.8s ease forwards 0.6s;
}

.line-2 {
  animation: textReveal 0.8s ease forwards 1.1s;
}

/* Animations */

@keyframes textReveal {
  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Fade out */

#siteLoader.hide {
  opacity: 0;
  visibility: hidden;
}

  </style>

    
</head>

<body>

  <div id="siteLoader">
    <div class="loader-content">
      <img src="/icons/logo.webp" class="loader-logo" alt="Logo">
      <div class="loader-text">
        <span class="line line-1">Découvrez</span>
        <span class="line line-2">votre menu</span>
      </div>
    </div>
  </div>

<div class="container-menu">

  <!-- HERO HEADER -->
<section class="hero">

  

    <!-- LOGO -->
    <div class="inner-hero-overlay">
      <div class="hero-left">
        <img src="/icons/logo.webp" alt="Logo" class="hero-logo">
      </div>

      <!-- MENU SWITCH -->
    <div class="hero-overlay">
      <div class="hero-center">
        <div class="switch-pill">
          <span id="menuIcon" class="switch-icon">☀️</span>

          <select id="menuToggle" class="switch-select">

            <option value="lunch"><%= ui.menu_toggle.lunch %></option>
            <option value="dinner"><%= ui.menu_toggle.dinner %></option>
          
            <% if (restaurant.features?.advancedMenus) { %>
              <option value="events"><%= ui.menu_toggle.events %></option>
              <option value="seasonal"><%= ui.menu_toggle.seasonal %></option>
            <% } %>
          
          </select>
        </div>
      </div>
 

      <!-- LANGUAGE -->
      <div class="hero-right">
        <div class="lang-pill">
          <select id="langToggle" class="switch-select">
            <% restaurant.languages.forEach(lang => { %>
              <option 
                value="<%= lang %>"
                <%= currentLang === lang ? "selected" : "" %>
              >
                <%= lang.toUpperCase() %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
  </div>

  </div>

</section>

  

    <div class="filters">

        <button class="filter" data-filter="formule">
            <img src="/icons/menu.webp" class="filter-icon" alt="">
            <span><%= categories.formule %></span>
        </button>
        
        <button class="filter active" data-filter="boisson">
            <img src="/icons/drink.webp" class="filter-icon" alt="">
            <span><%= categories.boisson %></span>
        </button>
        
        <button class="filter" data-filter="entrée">
            <img src="/icons/starter.webp" class="filter-icon" alt="">
            <span><%= categories.entrée %></span>
        </button>
        
        <button class="filter" data-filter="plat">
            <img src="/icons/dinner.webp" class="filter-icon" alt="">
            <span><%= categories.plat %></span>
        </button>
        
        <button class="filter" data-filter="dessert">
            <img src="/icons/dessert.webp" class="filter-icon" alt="">
            <span><%= categories.dessert %></span>
        </button>
        
    
    </div>
    
    <div class="grid">

      <%
      let currentSub = null;
      
      dishes.forEach(d => {
      
        const sub = d.subcategory_name && d.subcategory_name.trim();
      
        if (sub && sub !== currentSub) {
      
          if (currentSub !== null) {
      %>
            </div> <!-- .group-cards -->
          </div> <!-- .group -->
      <%
          }
      
          currentSub = sub;
      %>
      
          <div class="group">
            <h2 class="subcategory-title"><%= currentSub %></h2>
            <div class="group-cards">
      
      <%
        }
      
      %>
      
        <div class="card"
        data-id="<%= d.id %>"
        data-slug="<%= restaurant.slug %>"
        data-category="<%= d.category %>"
        data-price="<%= (d.price_cents/100).toFixed(2) %> €"
        data-price-cents="<%= d.price_cents %>"
        
        data-glb="<%= d.has_ar ? d.glb_url : '' %>"
        data-usdz="<%= d.has_ar ? d.usdz_url : '' %>"
        data-scale="<%= d.scale %>"

        data-title="<%= d.title || '' %>"
        data-desc="<%= d.desc_short || '' %>"
        
        data-availability="<%= d.availability %>"
        data-image="<%= d.image_url || '' %>"
        data-tags="<%= d.tags ? d.tags.split('||').join('|') : '' %>"
             
             >
      
            <div class="card-image">
              <% if (d.image_url) { %>
                <img src="<%= d.image_url %>" />
              <% } %>
            </div>
      
            <div class="card-content">
              <strong class="card-title"><%= d.title || '' %></strong>

              <% if (d.desc_short) { %>
                <div class="card-desc"><%= d.desc_short %></div>
              <% } %>
      
              <div class="card-price">
                <%= (d.price_cents / 100).toFixed(2) %> €
              </div>
            </div>
      
        </div>
      
      <%
      });
      
      if (currentSub !== null) {
      %>
          </div>
        </div>
      <%
      }
      %>
      
      </div>
        
    
    
    <!-- ===== Overlay (inchangé) ===== -->
    
    <div id="sheet" class="sheet">

            <div class="sheet-panel">
        
            <!-- VISUAL -->
            <div class="sheet-visual">
                <button id="sheet-close" class="sheet-close">✕</button>
                <% if (restaurant.features?.share) { %>
                  <button id="sheet-share" class="sheet-share">🔗</button>
                  <% } %>
        
                <div id="viewer">
                <div class="viewer-bg"></div>
                <div id="loader">Chargement…</div>
                <canvas id="three-canvas"></canvas>
                <img id="fallback-image" />
                </div>
            </div>
        
            <!-- CONTENT -->
            <div class="sheet-content">

                <div class="inner-sheet-content">
                    <div class="sheet-header-row">
                    <h2 id="sheet-title"></h2>
                    <div id="sheet-price"></div>
                    </div>
            
                    <p id="sheet-desc"></p>
                </div>
        
                <!-- FUTURE TAGS -->
                <div class="sheet-tags">
                <!-- Pastilles dynamiques plus tard -->
                </div>

                <div class="btn-overlay">
                  <button class="list-btn">
                    <%= ui.buttons.add_to_list %>
                  </button>
            
                    <a id="ar-btn" class="ar-btn" rel="ar">
                      <%= ui.buttons.ar_view %>
                    </a>
                </div>
        
            </div>
        
            </div>
      
      </div>
      
</div> 
<%- include("partials/footer") %>



<div id="app-config"
     data-slug="<%= restaurant.slug %>">
</div>

<script id="ui-data" type="application/json">
  <%- JSON.stringify(ui) %>
</script>



    <script type="module" src="/js/app.js"></script>
    <script type="module" src="/js/viewer3D/viewer.js"></script>

    <script src="/js/loader.js"></script>

    <script src="/js/menu-select.js"></script>

      
      
      

</body>
</html>
