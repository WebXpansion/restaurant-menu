<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= restaurant.name %></title>
<!-- Importmap Three.js -->
<script type="importmap">
    {
      "imports": {
        "three": "/vendor/three/three.module.js",
        "three/examples/jsm/": "/vendor/three/examples/jsm/"
      }
    }
    </script>
    
    
    

  <style>
body {
  font-family: system-ui;
  margin: 0;
  background: #f4f5f7;
}

/* conteneur global */
.container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 20px;
}

/* mobile */
@media (max-width: 768px) {
  .container {
    padding: 0px;
  }
}


    h1 {
      margin-bottom: 30px;
    }


    .grid {
  display: block;
  padding: 0px 16px 16px 16px;
}

.group {
  margin-bottom: 32px;
}



.group-cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}



@media (min-width: 768px) {
  .group-cards {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
}

@media (min-width: 1024px) {
  .group-cards {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
}

.card {
  display: flex;
}

.card.hidden {
  display: none;
}



    .card {
  gap: 24px;
  border-radius: 16px;
  cursor: pointer;
}

.card-image {
    width: 130px;
    height: auto;
    min-height: 110px;
  flex-shrink: 0;
  border-radius: 8px;
  overflow: hidden;
  background: #f2f2f2;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
}

.card-desc {
  font-size: 13px;
  color: #666;
  line-height: 1.3;
  font-weight: 400;
  margin: 4px 0;
}

.card-price {
  font-size: 13px;
  font-weight: 400;
  margin-top: 8px;
}


    .card:hover {
      transform: scale(1.02);
    }

    .price {
      font-weight: bold;
      margin-top: 8px;
    }




    /* ========== OVERLAY ========== */


.sheet {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
  z-index: 1000;
}

.sheet.open {
  opacity: 1;
  pointer-events: auto;
}

/* ===== PANEL ===== */
.sheet-panel {
  width: 100%;
  max-width: 680px;
  background: #fff;
  border-radius: 28px 28px 0 0;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform .35s cubic-bezier(.22,.8,.25,1);
}

.sheet.open .sheet-panel {
  transform: translateY(0);
}

/* ===== IMAGE / CANVAS ===== */
.sheet-visual {
  position: relative;
  width: 100%;
  height: auto;
}

#viewer {
  width: 100%;
  height: 100%;
  position: relative;
}

#three-canvas,
#fallback-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* CLOSE BUTTON */
.sheet-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: rgba(255,255,255,.9);
  border: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 18px;
  cursor: pointer;
  z-index: 2;
}

/* ===== CONTENT AREA ===== */
.sheet-content {
  padding: 20px;
  padding-bottom: 40px; /* espace visuel */
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.btn-overlay {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

/* TITLE + PRICE ROW */
.sheet-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
}

#sheet-title {
  font-size: 20px;
  font-weight: 600;
  margin: 0;
}

#sheet-price {
  font-size: 16px;
  font-weight: 500;
}



/* TAGS FUTURE */
.sheet-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* PRIMARY BUTTON */
.liste-btn {
    padding: 24px 20px;
    border-radius: 12px;
    border: 1px solid #ddd;
    background: #fff;
    font-weight: 600;
    cursor: pointer;
    font-size: 16px;
    line-height: 20px;
}

/* AR BUTTON */
.ar-btn {
  display: block;
  text-align: center;
  padding: 24px 20px;
  border-radius: 12px;
  background: #000;
  color: #fff;
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  line-height: 20px;
}

/* RESPONSIVE */
@media (min-width: 768px) {
  .sheet-panel {
    border-radius: 28px;
    margin-bottom: 40px;
  }

  .sheet-visual {
    height: 420px;
  }
}


#sheet-close {
  float:right;
  background:none;
  border:none;
  font-size:22px;
  cursor:pointer;
  background: white;
  z-index: 99;
}

#viewer {
  position: relative;
  height: 400px;
  background: #eee;
  overflow: hidden;
}

.viewer-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: blur(40px);
  transform: scale(2);
  opacity: 0;
  transition: opacity .3s ease;
  z-index: 0;
}

#three-canvas {
  width:100%;
  height:100%;
  display:block;
  position: relative;
  z-index: 2;
}

#fallback-image {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: none;
}

#loader {
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  background:#f3f3f3;
}


/**/
.thumb {
  width: 100%;
  height: 140px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 10px;
}

.card-content {
  display:flex;
  justify-content:center;
  align-items:flex-start;
}
.desc-short {
  font-size: 13px;
  color: #666;
  margin-top: 4px;
}




.filters {
  display:flex;
  gap:10px;
  overflow-x:auto;
  margin-bottom: 10px;
}

.filter {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 500;
    color: #111;
    border: 1px solid #0000001C;
    cursor: pointer;
    background: none;
    transition: all .2s ease;
}

.filter img{
    width: 22px;
    height: 22px;
}

.filter.active {
  background:black;
  color:white;
  border-color:black;
}





.subcategory-title {
  margin-top: 28px;
  margin-bottom: 12px;
  font-size: 20px;
  font-weight: 700;
  color: #111;
}


.info-sheet-content{
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 16px;
}

p#sheet-price {
    width: 20%;
    text-align: right;
}

#sheet-desc {
    margin: 0;
    color: #666;
    line-height: 1.4;
    width: 80%;
    font-size: 13px;
}

.inner-sheet-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.group > h2 {
  grid-column: 1 / -1;
  margin-bottom: 8px;
  font-size: 18px !important;
    font-family: "system-ui";
    font-weight: 500 !important;
    margin-bottom: 14px;
}

.group {
  display: none;
}

.group.show {
  display: block;
}

h1,h2{
    font-family: "system-ui";
    margin: 0;
}

.sheet-tags {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.sheet-tag {
  padding:6px 12px;
  border-radius:999px;
  background:#f0f0f0;
  font-size:12px;
  font-weight:500;
}


/**/
/* ======================
   HERO HEADER
====================== */

.hero {
  position: relative;
  height: 200px;
  background-image: url("/icons/restaurant.webp");
  background-size: cover;
  background-position: center;
}

.hero::after {
  content:"";
  position:absolute;
  inset:0;
  background: rgba(0,0,0,.35);
}

.hero-overlay {
  position: relative;
  z-index: 2;
  height:100%;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap: 12px;
}

.hero-logo {
  width:48px;
  height:48px;
  object-fit:contain;
}

.hero-center {
  display:flex;
  justify-content:center;
  flex:1;
}

.switch-pill {
  display:flex;
  align-items:center;
  gap:8px;
  padding:10px 16px;
  border-radius:999px;
  background: rgba(255,255,255,.2);
  backdrop-filter: blur(10px);
  color:white;
  font-weight:600;
}

.lang-pill {
  padding:10px 14px;
  border-radius:999px;
  background: rgba(255,255,255,.2);
  backdrop-filter: blur(10px);
}

.switch-select {
  border:none;
  background:transparent;
  color:white;
  font-size:16px;
  font-weight:600;
  outline:none;
  cursor:pointer;
}

.switch-select option {
  color:black;
}

.filters {
  margin-top: -40px;
  z-index: 10;
  position: relative;
  background: #f4f5f7;
  padding:20px;
  border-radius:24px 24px 0 0;
  border-bottom: 1px solid #eaeaea;
  overflow-x:auto;
  -ms-overflow-style: none;   /* IE / Edge */
  scrollbar-width: none;      /* Firefox */

}



.filters::-webkit-scrollbar {
  display: none;              /* Chrome / Safari */
}

.inner-hero-overlay {
    display: flex;
    gap: 12px;
    padding: 16px;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
}



/**/


  </style>

    
</head>

<body>

<div class="container-menu">

  <!-- HERO HEADER -->
<section class="hero">

  

    <!-- LOGO -->
    <div class="inner-hero-overlay">
      <div class="hero-left">
        <img src="/icons/logo.webp" alt="Logo" class="hero-logo">
      </div>

      <!-- MENU SWITCH -->
    <div class="hero-overlay">
      <div class="hero-center">
        <div class="switch-pill">
          <span class="switch-icon">☀️</span>

          <select id="menuToggle" class="switch-select">
            <option value="lunch">Midi</option>
            <option value="dinner">Soir</option>
          </select>
        </div>
      </div>
 

      <!-- LANGUAGE -->
      <div class="hero-right">
        <div class="lang-pill">
          <select id="langToggle" class="switch-select">
            <option value="fr">🇫🇷</option>
            <option value="en">🇬🇧</option>
          </select>
        </div>
      </div>
  </div>

  </div>

</section>

  

    <div class="filters">

        <button class="filter" data-filter="formule">
            <img src="/icons/menu.webp" class="filter-icon" alt="">
            <span>Formules</span>
        </button>
        
        <button class="filter active" data-filter="boisson">
            <img src="/icons/drink.webp" class="filter-icon" alt="">
            <span>Boisson</span>
        </button>
        
        <button class="filter" data-filter="entrée">
            <img src="/icons/starter.webp" class="filter-icon" alt="">
            <span>Entrée</span>
        </button>
        
        <button class="filter" data-filter="plat">
            <img src="/icons/dinner.webp" class="filter-icon" alt="">
            <span>Plats</span>
        </button>
        
        <button class="filter" data-filter="dessert">
            <img src="/icons/dessert.webp" class="filter-icon" alt="">
            <span>Desserts</span>
        </button>
        
    
    </div>
    
    <div class="grid">

        <%
    let currentSub = null;
    dishes.forEach(d => {
    if (currentSub !== d.subcategory_name) {

        // ferme le groupe précédent
        if (currentSub !== null) {
    %>
            </div> <!-- .group-cards -->
        </div> <!-- .group -->
    <%
        }

        currentSub = d.subcategory_name;
    %>

    <div class="group" data-category="<%= d.category %>">
    <h2 class="subcategory-title"><%= currentSub %></h2>
    <div class="group-cards">

    <%
    }
    %>

        <div
        class="card"
        data-id="<%= d.id %>"
        data-slug="<%= restaurant.slug %>"
        data-category="<%= d.category %>"
        data-title="<%= d.title_fr %>"
        data-price="<%= (d.price_cents/100).toFixed(2) %> €"
        data-desc="<%= d.desc_long_fr %>"
        data-glb="<%= d.has_ar ? d.glb_path : '' %>"
        data-usdz="<%= d.has_ar ? d.usdz_path : '' %>"
        data-scale="<%= d.scale %>"
        data-title-fr="<%= d.title_fr %>"
        data-title-en="<%= d.title_en %>"
        data-short-fr="<%= d.desc_short_fr %>"
        data-short-en="<%= d.desc_short_en %>"
        data-long-fr="<%= d.desc_long_fr %>"
        data-long-en="<%= d.desc_long_en %>"
        data-availability="<%= d.availability %>"
        data-image="<%= d.image_path || '' %>"
        data-tags="<%= d.tags ? d.tags.split('||').join('|') : '' %>"

        >
        <div class="card-image">
            <% if (d.image_path) { %>
            <img src="<%= d.image_path %>" />
            <% } %>
        </div>

        <div class="card-content">
            <strong class="card-title"><%= d.title_fr %></strong>

            <% if (d.desc_short_fr) { %>
            <div class="card-desc"><%= d.desc_short_fr %></div>
            <% } %>

            <div class="card-price">
            <%= (d.price_cents / 100).toFixed(2) %> €
            </div>
        </div>
        </div>

    <%
    });

    // ferme le dernier groupe
    if (currentSub !== null) {
    %>
        </div> <!-- .group-cards -->
    </div> <!-- .group -->
    <%
    }
    %>

        
    </div>
        
    
    
    <!-- ===== Overlay (inchangé) ===== -->
    
    <div id="sheet" class="sheet">

            <div class="sheet-panel">
        
            <!-- VISUAL -->
            <div class="sheet-visual">
                <button id="sheet-close" class="sheet-close">✕</button>
        
                <div id="viewer">
                <div class="viewer-bg"></div>
                <div id="loader">Chargement…</div>
                <canvas id="three-canvas"></canvas>
                <img id="fallback-image" />
                </div>
            </div>
        
            <!-- CONTENT -->
            <div class="sheet-content">

                <div class="inner-sheet-content">
                    <div class="sheet-header-row">
                    <h2 id="sheet-title"></h2>
                    <div id="sheet-price"></div>
                    </div>
            
                    <p id="sheet-desc"></p>
                </div>
        
                <!-- FUTURE TAGS -->
                <div class="sheet-tags">
                <!-- Pastilles dynamiques plus tard -->
                </div>

                <div class="btn-overlay">
                    <button class="liste-btn">
                    Ajouter dans ma liste
                    </button>
            
                    <a id="ar-btn" class="ar-btn" rel="ar">
                    Voir en réalité augmentée
                    </a>
                </div>
        
            </div>
        
            </div>
      
      </div>
      
</div> 

    <script>
        window.RESTAURANT_SLUG = "<%= restaurant.slug %>";
    </script>
    

    <script type="module" src="/js/app.js"></script>
    <script type="module" src="/js/viewer3D/viewer.js"></script>

    
  
  

</body>
</html>
