<link rel="stylesheet" href="/css/landing-page.css">
<meta name="viewport" content="width=device-width, initial-scale=1" />

<header class="site-header">

  <div class="header-inner">

    <!-- LEFT NAV (desktop only) -->
    <nav class="nav-left desktop-only">
      <a href="/">Accueil</a>
      <a href="/pricing">Tarifs</a>
    </nav>

    <!-- LOGO -->
    <div class="logo">
      <a href="/">
        <img src="/icons/logo.webp" alt="plateview">
      </a>
    </div>

    <!-- RIGHT NAV (desktop only) -->
    <div class="nav-right desktop-only">
      <a href="#contact-form-card">Nous contacter</a>
      <div class="bell-icon">
        <img src="/icons/contacter.svg" alt="dishes">
      </div>
    </div>

    <!-- HAMBURGER (mobile only) -->
    <button class="hamburger mobile-only" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- MOBILE MENU -->
  <div class="mobile-menu">
    <nav>
      <a href="/">Accueil</a>
      <a href="/pricing">Nos offres</a>
      <a href="#contact-form-card">Nous contacter</a>
    </nav>
  </div>

</header>

<div class="site-wrapper">
  <section class="pricing-section">

    <div class="pricing-header">
      <h1>
        <span class="accent">Plus Qu’un Menu,</span><br>
        Une Expérience À Table
      </h1>

      <a href="#comparatif" class="compare-link">
        Comparer les fonctionnalités ↓
      </a>
    </div>

    <div class="pricing-cards">

      <!-- Découverte -->
      <div class="pricing-card">
        <div class="card-inner">
          <h3>Découverte</h3>
          <p class="card-desc">
            Parfait pour les restaurants qui souhaitent moderniser leur carte.
          </p>

          <div class="price">
            79 € <span>/ mois HT</span>
          </div>

          <button class="btn btn-primary light">
            Choisir cette formule
          </button>

          <div class="divider"></div>

          <p class="included-title">Inclus</p>

          <ul class="features">
            <li>10 plats modélisés en réalité augmentée</li>
            <li>Traduction du menu en 1 langue</li>
            <li>Carte dynamique midi/soir</li>
            <li>Dashboard de gestion</li>
          </ul>
        </div>
      </div>


      <!-- Croissance (FEATURED) -->
      <div class="pricing-card featured">
        <div class="card-inner">
          <h3>Croissance</h3>
          <p class="card-desc">
            Pour attirer plus de clients, plus d’avis Google et plus de revenus.
          </p>

          <div class="price">
            159 € <span>/ mois HT</span>
          </div>

          <button class="btn btn-primary light">
            Choisir cette formule
          </button>

          <div class="divider"></div>

          <p class="included-title">Inclus en plus du pack Découverte</p>

          <ul class="features">
            <li>20 plats modélisés</li>
            <li>Traduction en 4 langues</li>
            <li>Carte saisonnière dynamique</li>
            <li>Avis Google</li>
            <li>Statistiques</li>
          </ul>
        </div>
      </div>


      <!-- Excellence -->
      <div class="pricing-card">
        <div class="card-inner">
          <h3>Excellence</h3>
          <p class="card-desc">
            Pour piloter votre performance et viser l’excellence.
          </p>

          <div class="price">
            300 € <span>/ mois HT</span>
          </div>

          <button class="btn btn-primary light">
            Choisir cette formule
          </button>

          <div class="divider"></div>

          <p class="included-title">Inclus en plus du pack Croissance</p>

          <ul class="features">
            <li>Plats illimités</li>
            <li>Traduction en 10 langues</li>
            <li>Partage réseaux</li>
            <li>Historique & stats avancées</li>
          </ul>
        </div>
      </div>

    </div>

  </section>
</div>

<script>
  const hamburger = document.querySelector(".hamburger");
  const mobileMenu = document.querySelector(".mobile-menu");
  
  hamburger.addEventListener("click", () => {
    mobileMenu.classList.toggle("active");
    document.body.style.overflow = 
      mobileMenu.classList.contains("active") ? "hidden" : "auto";
  });
  
  // Fermer au clic sur un lien
  document.querySelectorAll(".mobile-menu a").forEach(link => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("active");
      document.body.style.overflow = "auto";
    });
  });
  </script>