<script>
  const hamburger = document.querySelector(".hamburger");
  const mobileMenu = document.querySelector(".mobile-menu");
  
  hamburger.addEventListener("click", () => {
    mobileMenu.classList.toggle("active");
    document.body.style.overflow = 
      mobileMenu.classList.contains("active") ? "hidden" : "auto";
  });
  
  // Fermer au clic sur un lien
  document.querySelectorAll(".mobile-menu a").forEach(link => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("active");
      document.body.style.overflow = "auto";
    });
  });
  </script>

<script>
  const plans = ["Découverte", "Croissance", "Excellence"];
  let currentPlanIndex = 0;
  
  const data = [
    {
      section: "Expérience 3D & réalité augmentée",
      items: [
        { title: "Visualisation 3D & réalité augmentée", values: ["check","check","check"] },
        { title: "Plats, desserts & cocktails modélisés en 3D", values: ["check","check","check"] },
        { title: "Maintenance technique & sécurité", values: ["check","check","check"] }
      ]
    },
    {
      section: "QR code & supports physiques",
      items: [
        { title: "30 QR code personnalisés", values: ["check","check","check"] },
        { title: "Supports premium", values: ["Option","Option","Option"] }
      ]
    },
    {
      section: "Gestion du menu",
      items: [
        { title: "Menu multilingue", values: ["2 langues","4 langues","8 langues"] },
        { title: "Cartes dynamiques (midi / soir)", values: ["check","check","check"] },
        { title: "Cartes événementielles & saisonnières", values: ["cross","check","check"] },
        { title: "Désactivation d’un plat en rupture", values: ["check","check","check"] }
      ]
    },
    {
      section: "Statistiques & performances",
      items: [
        { title: "Nombre de consultations du menu", values: ["cross","check","check"] },
        { title: "Plats les plus consultés", values: ["cross","check","check"] },
        { title: "Analyse des périodes d’affluence", values: ["cross","check","check"] },
        { title: "Historique & comparaisons", values: ["cross","cross","check"] }
      ]
    },
    {
      section: "Marketing",
      items: [
        { title: "Création de publications pour vos réseaux sociaux", values: ["check","check","check"] },
        { title: "Export en ratio 1/1 et 9/16 (stories)", values: ["check","check","check"] }
      ]
    },
    {
      section: "Avis & engagement clients",
      items: [
        { title: "Redirection vers avis Google Business", values: ["cross","check","check"] },
        { title: "Partage d’un plat sur les réseaux sociaux", values: ["cross","cross","check"] }
      ]
    },
    {
      section: "Options & accompagnement",
      items: [
        { title: "Accompagnement & support", values: ["check","check","check"] },
        { title: "Support prioritaire", values: ["cross","check","check"] },
        { title: "Mise en avant sur l’annuaire Plateview", values: ["Option (5 € / mois)","check","check"] },
        { title: "Création d’un site web complémentaire", values: ["Option (100 € / mois)","Option (100 € / mois)","Option (100 € / mois)"] },
        { title: "Site web personnalisé", values: ["Sur devis","Sur devis","Sur devis"] },
        { title: "Déplacement pour scan & ajout de plats", values: ["Option (199 € / déplacement)","Option (199 € / déplacement)","Option (199 € / déplacement)"] }
      ]
    }
  ];
  
  const planNameEl = document.getElementById("plan-name");
  const featuresContainer = document.getElementById("mobile-features");
  
  function renderFeatures() {
  planNameEl.textContent = plans[currentPlanIndex];
  featuresContainer.innerHTML = "";

  data.forEach(section => {

    const sectionTitle = document.createElement("h3");
    sectionTitle.classList.add("mobile-section-title");
    sectionTitle.textContent = section.section;
    featuresContainer.appendChild(sectionTitle);

    section.items.forEach((item, index) => {

      const row = document.createElement("div");
      row.classList.add("mobile-feature-row");

      // ✅ Alternance background
      if (index % 2 === 0) {
        row.style.background = "#F2F2F2";
      } else {
        row.style.background = "#FFFFFF";
      }

      const title = document.createElement("div");
      title.classList.add("mobile-feature-title");
      title.textContent = item.title;

      const value = document.createElement("div");
      const featureValue = item.values[currentPlanIndex];

      if (featureValue === "check") {
        value.classList.add("mobile-check");
      } else if (featureValue === "cross") {
        value.classList.add("mobile-cross");
      } else {
        value.classList.add("mobile-feature-value");
        value.textContent = featureValue;
      }

      row.appendChild(title);
      row.appendChild(value);
      featuresContainer.appendChild(row);

    });

  });
}
  
function changePlan(direction) {

featuresContainer.style.opacity = "0";

// 🔥 Force le navigateur à appliquer le style
featuresContainer.offsetHeight;

setTimeout(() => {
  currentPlanIndex = (currentPlanIndex + direction + plans.length) % plans.length;
  renderFeatures();

  // petit délai pour que le DOM soit prêt
  requestAnimationFrame(() => {
    featuresContainer.style.opacity = "1";
  });

}, 250);
}

document.getElementById("prev-plan").addEventListener("click", () => {
  changePlan(-1);
});

document.getElementById("next-plan").addEventListener("click", () => {
  changePlan(1);
});
  
  renderFeatures();
  </script>