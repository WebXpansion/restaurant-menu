<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Mot de passe oublié</title>

<style>
body {
  margin: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", Inter, system-ui;
  background: linear-gradient(180deg, #f5f5f7 0%, #e5e5ea 100%);
}

.wrapper {
    width: -webkit-fill-available;
  max-width: 380px;
  padding: 40px;
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(20px);
  border-radius: 28px;
  box-shadow:
    0 20px 60px rgba(0,0,0,0.12),
    0 4px 10px rgba(0,0,0,0.05);
}

h2 {
  text-align: center;
  margin-bottom: 30px;
  font-weight: 600;
}

input {
    width: -webkit-fill-available;
  padding: 16px;
  border-radius: 14px;
  border: 1px solid #e5e5ea;
  background: #f5f5f7;
  font-size: 15px;
  outline: none;
  margin-bottom: 18px;
}

input:focus {
  background: white;
  border-color: #111;
}

button {
  width: 100%;
  padding: 16px;
  border-radius: 14px;
  border: none;
  background: black;
  color: white;
  font-weight: 600;
  cursor: pointer;
}

button:hover {
  background: #111;
}

.message {
  text-align: center;
  font-size: 14px;
  color: #555;
  margin-bottom: 20px;
}
</style>
</head>

<body>

<div class="wrapper">

  <h2>Mot de passe oublié</h2>

  <% if (success) { %>
    <div class="message">
      Si un compte existe avec cet email, un lien de réinitialisation a été envoyé.
    </div>
  <% } else { %>

    <form method="POST">
      <input 
        type="email" 
        name="email" 
        placeholder="Email administrateur"
        required 
      />
      <button type="submit">
        Envoyer le lien
      </button>
    </form>

  <% } %>

</div>

</body>
</html>