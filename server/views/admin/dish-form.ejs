<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/admin.css">

  <title><%= dish ? "Modifier le plat" : "Nouveau plat" %></title>

  <style>
    body {
      margin: 0;
      background: #f5f5f7;
      font-family: -apple-system, BlinkMacSystemFont, system-ui;
      color: #111;
    }

    .container {
      max-width: 960px;
      margin: 40px auto;
      padding: 0 20px;
    }

    h1 {
      margin-bottom: 24px;
    }

    .card {
      background: white;
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 24px;
      box-shadow:
        0 10px 30px rgba(0,0,0,.08),
        0 1px 3px rgba(0,0,0,.05);
    }

    .card h2 {
      font-size: 18px;
      margin-bottom: 16px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }

    label {
      font-size: 13px;
      color: #666;
    }

    input, textarea, select {
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid #ddd;
      font-size: 15px;
      outline: none;
    }

    textarea {
      min-height: 90px;
      resize: vertical;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .row-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .file-box {
      border: 1px dashed #ccc;
      border-radius: 14px;
      padding: 14px;
      background: #fafafa;
      font-size: 14px;
    }

    .file-box strong {
      display: block;
      margin-top: 6px;
      font-size: 13px;
      color: #555;
    }

    .inline {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn {
      padding: 12px 18px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      font-size: 15px;
    }

    .btn.primary {
      background: #000;
      color: white;
    }


    .actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    @media (max-width: 720px) {
      .row, .row-3 {
        grid-template-columns: 1fr;
      }
    }

    .hint {
  font-size: 12px;
  color: #888;
  font-weight: 400;
  margin-left: 6px;
}


    button[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}


/*pastille*/

.tag-container {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-bottom:16px;
}

.tag-pill {
  display:flex;
  align-items:center;
  gap:8px;
  padding:6px 12px;
  border-radius:999px;
  background:#eee;
  font-size:13px;
}

.tag-pill button {
  border:none;
  background:none;
  cursor:pointer;
  font-size:14px;
}

.tag-controls {
  display:flex;
  gap:8px;
  margin-bottom:20px;
}

.tag-controls select {
  flex:1;
}

.tag-admin-list {
  margin-top:16px;
  border-top:1px solid #eee;
  padding-top:12px;
}

.tag-admin-item {
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:6px 0;
  font-size:13px;
}



  </style>
</head>

<body>
  <%- include("partials/header", { restaurant, active: "dashboard" }) %>

<div class="container">

  <h1><%= dish ? "✏️ Modifier le plat" : "➕ Nouveau plat" %></h1>

  <form
  id="dishForm"
  method="POST"
  enctype="multipart/form-data"
  action="<%= dish
    ? `/admin/dishes/${dish.id}/edit`
    : `/admin/dishes/new` %>"
>

    <!-- INFOS -->
    <div class="card">
      <h2>Informations</h2>

      <% restaurant.languages.forEach(lang => { %>

        <div class="field">
          <label>Titre <%= lang.toUpperCase() %></label>
          <input 
          name="title_<%= lang %>" 
          required 
          value="<%= translations?.[lang]?.title || '' %>"
        >
        </div>
      
      <% }) %>

      <div class="row">
        <div class="field">
          <label>Catégorie</label>
          <select name="category" required>
            <% ["formule","entrée","plat","dessert","boisson"].forEach(c => { %>
              <option value="<%= c %>" <%= dish?.category === c ? "selected" : "" %>>
                <%= c %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label>Sous-catégorie</label>
          <div class="inline">
            <select name="subcategory_id">
              <option value="">— Aucune —</option>
              <% subcategories.forEach(s => { %>
                <option value="<%= s.id %>" <%= dish?.subcategory_id === s.id ? "selected" : "" %>>
                  <%= s.name %>
                </option>
              <% }) %>
            </select>
            <button type="button" class="btn secondary" id="addSubBtn">+ Nouvelle</button>
          </div>
        </div>
      </div>
    </div>

<!-- DESCRIPTIONS -->
<div class="card">
  <h2>Descriptions</h2>

  <% restaurant.languages.forEach(lang => { %>

    <div class="field">
      <label>
        Courte <%= lang.toUpperCase() %>
        <span class="hint">15 mots maximum</span>
      </label>

      <textarea
      name="desc_short_<%= lang %>"
      class="desc-short"
      data-max-words="15"
    ><%= translations?.[lang]?.desc_short || '' %></textarea>

    </div>

  <% }) %>

</div>

    

    <!-- PRIX / DISPO / STATUT -->
    <div class="card">
      <h2>Publication</h2>

      <div class="row-3">
        <div class="field">
          <label>Prix (€)</label>
          <input required type="number" step="0.01" name="price"
            value="<%= dish ? (dish.price_cents/100).toFixed(2) : "" %>">
        </div>

        <div class="field">
          <label>Disponibilité</label>
          <select required name="availability">
        
            <option value="both"
              <%= dish?.availability==="both"?"selected":"" %>>
              Tout
            </option>
        
            <option value="lunch"
              <%= dish?.availability==="lunch"?"selected":"" %>>
              Midi
            </option>
        
            <option value="dinner"
              <%= dish?.availability==="dinner"?"selected":"" %>>
              Soir
            </option>
        
            <% if (restaurant.features?.advancedMenus) { %>
        
              <option value="events"
                <%= dish?.availability==="events"?"selected":"" %>>
                Événements
              </option>
        
              <option value="seasonal"
                <%= dish?.availability==="seasonal"?"selected":"" %>>
                Saisonniers
              </option>
        
            <% } %>
        
          </select>
        </div>

        <div class="field">
          <label>Statut</label>
          <select name="status">
            <option value="published" <%= dish?.status==="published"?"selected":"" %>>🟢 Publié</option>
            <option value="draft" <%= dish?.status==="draft"?"selected":"" %>>⚪ Brouillon</option>
          </select>
        </div>
      </div>
    </div>




<!-- RÉALITÉ AUGMENTÉE -->
<div class="card">
  <label style="display:flex;align-items:center;gap:10px">
    <input
      type="checkbox"
      id="hasArToggle"
      name="has_ar"
      value="1"
      <%= dish?.has_ar ? "checked" : "" %>
    >

    <div style="display:flex;align-items:center;gap:10px">
      <strong>Voir le plat en réalité augmentée</strong>
    
      <% if (restaurant.limits?.maxArDishes) { %>
        <span class="ar-usage-pill">
          <%= arUsage.used %>/<%= restaurant.limits.maxArDishes %> AR
        </span>
      <% } %>
    </div>
    
  </label>

  <p style="font-size:13px;color:#666;margin-top:6px">
    Active l’affichage 3D et AR pour ce plat
  </p>
</div>



    <!-- MEDIA -->
    <div class="card">
      <h2>Médias</h2>

      <div class="row">
        <div class="file-box">
          Image
          <input
            type="file"
            name="image"
            accept="image/*"
            id="imageInput"
          >
        
          <!-- PREVIEW -->
          <img
            id="imagePreview"
            src="<%= dish?.image_url || '' %>"
            style="
              margin-top:10px;
              width:100%;
              max-height:180px;
              object-fit:cover;
              border-radius:12px;
              display:<%= dish?.image_url ? 'block' : 'none' %>;
            "
          >
        
          <% if (dish?.image_original_name) { %>
            <strong><%= dish.image_original_name %></strong>
          <% } %>
        </div>
        

        <div id="arFields" style="display:none">
          <div class="file-box">
            Modèle 3D (GLB)
            <span class="required-ar">*</span>
            <input type="file" name="glb" accept=".glb" id="glbInput" data-existing="<%= dish?.glb_url ? 1 : 0 %>">
            <% if (dish?.glb_original_name) { %>
              <strong><%= dish.glb_original_name %></strong>
            <% } %>
          </div>
        
          <div class="file-box">
            Réalité augmentée (USDZ)
            <span class="required-ar">*</span>
            <input type="file" name="usdz" accept=".usdz" id="usdzInput" data-existing="<%= dish?.usdz_url ? 1 : 0 %>">
            <% if (dish?.usdz_original_name) { %>
              <strong><%= dish.usdz_original_name %></strong>
            <% } %>
          </div>
        </div>
        
      </div>

      <div class="field" style="margin-top:16px">
        <label>Scale 3D</label>
        <input type="number" step="0.1" name="scale" value="<%= dish?.scale || 1 %>">
      </div>
    </div>

    <!-- ACTIONS -->
    <div class="card actions">
      <a href="/admin/dishes" class="btn secondary">Annuler</a>
      <button type="submit" class="btn primary">
        <%= dish ? "Enregistrer" : "Créer le plat" %>
      </button>
    </div>

  </form>
</div>

<!-- 🔒 Overlay limite AR -->
<div id="arLimitOverlay" class="overlay hidden">
  <div class="overlay-box">
    <h2>Limite atteinte</h2>
    <p id="arLimitText"></p>

    <div class="overlay-actions">
      <button id="closeOverlay" class="btn secondary">
        Annuler
      </button>

      <a href="/pricing" class="btn primary">
        Voir nos offres
      </a>
    </div>
  </div>
</div>

<script src="/js/admin/dish-form.js"></script>
<script src="/js/admin-dishes.js"></script>


</body>
</html>
