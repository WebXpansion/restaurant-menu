<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/admin.css">

  <title>Dashboard – <%= restaurant.name %></title>


  <style>
    body {
      margin: 0;
      background: #f5f5f7;
      font-family: -apple-system, BlinkMacSystemFont, system-ui;
      color: #111;
    }

    .container {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 20px;
    }

    h1 {
      margin-bottom: 6px;
    }

    p{
      margin: 0;
    }

    .subtitle {
      font-size: 15px;
      color: #666;
      margin-bottom: 40px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 12px;
    }

    .inner-cart {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

    .card {
      display: flex;
      justify-content: center;
      align-items: center;
      border: 1px solid white;
      gap: 24px;
      background: #FAFAFA;
      border-radius: 20px;
      padding: 28px;
      box-shadow:
        0 20px 40px rgba(0,0,0,.08),
        0 2px 6px rgba(0,0,0,.06);
      text-decoration: none;
      color: inherit;
      transition: transform .15s ease, box-shadow .15s ease;
      min-height: 90px;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow:
        0 30px 60px rgba(0,0,0,.12),
        0 4px 10px rgba(0,0,0,.08);
    }

    .icon img {
      width: 64px;
      height: auto;
    }

    .card h3 {
      font-size: 18px;
    }

    .card p {
      font-size: 14px;
      color: #bdbdbd;
      line-height: 1.4;
    }

    .footer {
      margin-top: 50px;
      font-size: 13px;
      color: #888;
      text-align: center;
    }

    .card-locked {
  opacity: 1;
  cursor: pointer;
  position: relative;
}

.badge-locked {
  font-size: 11px;
    background: #AD1A1A;
    padding: 4px 8px;
    color: white;
    border-radius: 28px;
    margin-left: 8px;
    position: absolute;
    right: 0;
    top: 0;
    margin: 12px;
}

.upgrade-text {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: #777;
}


@media screen and (max-width:760px){
  .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 12px;
    }

    .card p{
      font-size: 12px;
    }

    .card h3{
      font-size: 16px;
    }

    .card{
      padding: 14px;
    }

    .icon img {
    width: 44px;
}
}

  </style>
</head>

<body>

  <%- include("partials/header", { restaurant, active: "dashboard" }) %>


<div class="container">

  <h1>Dashboard</h1>
  <p class="subtitle">
    Gestion du restaurant <strong><%= restaurant.name %></strong>
  </p>
  <div class="grid">

    <!-- STATS -->
    <% const features = restaurant.features || {}; %>
    
    

    <a 
    href="<%= features.stats ? '/admin/stats' : '#' %>"
    class="card <%= features.stats ? '' : 'card-locked' %>"
    <% if (!features.stats) { %>
      data-locked="stats"
    <% } %>
  >
    <div class="icon">
      <img src="/icons/starter.webp">
    </div>
  
    <div class="inner-cart">
      <h3>Statistiques</h3>
      <p>
        Suivez les consultations du menu, des plats
        et la réalité augmentée.
      </p>
    </div>
  
    <% if (!features.stats) { %>
      <span class="badge-locked">Offre 2 minimum</span>
    <% } %>
  </a>



    <!-- DISHES -->
    <a href="/admin/dishes" class="card">
      <div class="icon">
        <img src="/icons/dessert.webp">
      </div>
      <div class="inner-cart">
        <h3>Plats</h3>
        <p>
          Créez, modifiez et gérez les plats
          visibles sur votre menu.
        </p>
      </div>
    </a>

          <!-- Publicatoins -->
          <a href="/admin/publication" class="card">
            <div class="icon">
              <img src="/icons/dinner.webp">
            </div>
            <div class="inner-cart">
              <h3>Publications</h3>
              <p>
                Configurez les options du restaurant,
                avis Google et fonctionnalités.
              </p>
          </div>
          </a>

<!-- SETTINGS -->
<a 
  href="<%= features.googleReview ? '/admin/settings' : '#' %>"
  class="card <%= features.googleReview ? '' : 'card-locked' %>"
  <% if (!features.googleReview) { %>
    data-locked="reviews"
  <% } %>
>
  <div class="icon">
    <img src="/icons/drink.webp">
  </div>

  <div class="inner-cart">
    <h3>Avis</h3>
    <p>
      Consultez et modérez les avis clients
      pour améliorer votre réputation.
    </p>
  </div>

  <% if (!features.googleReview) { %>
    <span class="badge-locked">Offre 2 minimum</span>
  <% } %>
</a>



  </div>


  <div id="upgrade-modal" class="upgrade-modal">
    <div class="upgrade-content">
  
      <button id="upgrade-close" class="upgrade-close">✕</button>
  
      <h2>Débloquez les Statistiques</h2>
  
      <p>
        Analysez les vues de vos plats,
        les scans QR et les interactions AR.
      </p>
  
      <div class="upgrade-video">
        <video 
          src="/videos/stats-preview.mp4"
          autoplay
          muted
          loop
          playsinline
        ></video>
      </div>
  
      <a href="/admin/billing" class="upgrade-btn">
        Passer à l’offre 2
      </a>
  
    </div>
  </div>

</div>

<script src="/js/admin-dashboard.js"></script>

</body>
</html>
