<link rel="stylesheet" href="/css/admin-faq.css">
<link rel="stylesheet" href="/css/admin.css">
<meta name="viewport" content="width=device-width, initial-scale=1" />

<%- include("partials/header") %>

<div class="container">
    <section class="faq-header">
    <div>
        <h1>Aide</h1>
        <p class="subtitle">Vous avez des questions ? Consultez notre FAQ ou contactez-nous</p>
    </div>

    <div class="faq-actions">
        <a href="mailto:support@plateview.fr" class="btn-black">
        Mail
        </a>

        <a href="tel:+33600000000" class="btn-black">
        Nous contacter
        </a>
    </div>
    </section>

    <section class="faq-list">

        <% const questions = [
        {
          title: "Comment ajouter/modifier et supprimer un plat",
          video: "1118705399",
          text: "Voici comment ajouter, modifier ou supprimer un plat depuis votre tableau de bord."
        },
        {
          title: "Consulter les statistiques",
          video: "1141370800",
          text: "Accédez aux statistiques pour analyser les vues et interactions."
        },
        {
          title: "Créer une publication",
          video: "1141370900",
          text: "Découvrez comment créer une publication depuis l’espace admin."
        },
        {
          title: "Ajouter/Modifier un lien pour récolter des avis google",
          video: "1141371000",
          text: "Voici comment configurer votre lien Google Review."
        },
        {
          title: "Je peux changer d’offre à tout moment ?",
          video: "1141371100",
          text: "Oui, vous pouvez changer d’offre à tout moment depuis votre espace."
        },
        {
          title: "Je rencontre un problème sur le site ?",
          video: "1141371200",
          text: "Contactez-nous via le support ou consultez cette vidéo."
        },
        {
          title: "Je peux commander plus de stickers ?",
          video: "1141371300",
          text: "Oui, vous pouvez commander des stickers supplémentaires."
        }
      ]; %>

      <% questions.forEach((q, index) => { %>
        <div class="faq-item" data-index="<%= index %>">
      
          <button class="faq-question">
            <span><%= q.title %></span>
            <span class="arrow">⌄</span>
          </button>
      
          <div class="faq-answer">

            <p class="txt-faq"><%= q.text %></p>
      
            <% if (q.video) { %>
              <div class="video-wrapper">
                <iframe 
                  src="https://player.vimeo.com/video/<%= q.video %>"
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen>
                </iframe>
              </div>
            <% } %>
      

      
          </div>
      
        </div>
      <% }) %>

    </section>
</div>

<script src="/js/admin-faq.js"></script>