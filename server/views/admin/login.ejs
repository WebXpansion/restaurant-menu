<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Connexion – <%= restaurant.name %></title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", Inter, system-ui;
      background: linear-gradient(180deg, #f5f5f7 0%, #e5e5ea 100%);
    }

    .login-wrapper {
      width: 100%;
      max-width: 380px;
      padding: 40px;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(20px);
      border-radius: 28px;
      box-shadow:
        0 20px 60px rgba(0,0,0,0.12),
        0 4px 10px rgba(0,0,0,0.05);
    }

    .logo {
    flex-direction: column;
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 40px;
    color: #111;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 17px;
}

    h2 {
      font-size: 22px;
      margin-bottom: 30px;
      text-align: center;
      font-weight: 600;
    }

    .field {
      margin-bottom: 18px;
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid #e5e5ea;
      background: #f5f5f7;
      font-size: 15px;
      outline: none;
      transition: all 0.2s ease;
    }

    input:focus {
      background: #ffffff;
      border-color: #111;
    }

    button {
      width: 100%;
      margin-top: 10px;
      padding: 16px;
      border-radius: 14px;
      border: none;
      background: #000;
      color: #fff;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    button:hover {
      background: #111;
      transform: translateY(-1px);
    }

    .error {
      background: #fff1f1;
      border: 1px solid #ffd6d6;
      color: #c00;
      font-size: 14px;
      padding: 12px;
      border-radius: 12px;
      margin-bottom: 20px;
      text-align: center;
    }

    .footer {
      text-align: center;
      margin-top: 24px;
      font-size: 13px;
      color: #666;
    }

    @media (max-width: 480px) {
      .login-wrapper {
        margin: 20px;
        padding: 30px;
      }
    }


    .logo img {
      width: 60px;
      height: auto;
    }

  </style>
</head>

<body>

  <div class="login-wrapper">

    <div class="logo">
      <img src="/icons/logo.webp">
      <%= restaurant.name %>
    </div>

    <h2>Connexion</h2>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST">
      <div class="field">
        <input 
          type="email" 
          name="email" 
          placeholder="Email"
          required 
        />
      </div>

      <div class="field">
        <input 
          type="password" 
          name="password" 
          placeholder="Mot de passe"
          required 
        />
      </div>

      <button type="submit">
        Se connecter
      </button>

      <div style="text-align:center; margin-top:16px;">
        <a href="/admin/forgot-password" style="font-size:13px; color:#666;">
          Mot de passe oublié ?
        </a>
      </div>
    </form>

    <div class="footer">
      Interface administrateur
    </div>

  </div>

</body>
</html>