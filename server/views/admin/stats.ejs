<link rel="stylesheet" href="/css/admin.css">
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="stylesheet" href="/css/admin.css">

<script src="/vendor/chart/chart.umd.min.js"></script>

<style>


  h1 {

    margin-bottom: 6px;
  }

  img.icon-view-stats{
    width: 14px;
    height: auto;
}

  .subtitle {
    color: #666;
    font-size: 15px;
    margin-bottom: 32px;
  }

  .dish-row span {
    display: flex;
    gap: 8px;
    justify-content: center;
    align-items: center;
}

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
    gap: 12px;
  }

  .card {
    background: white;
    border-radius: 20px;
    padding: 24px;
    box-shadow:
      0 20px 40px rgba(0,0,0,.08),
      0 2px 6px rgba(0,0,0,.06);
  }

  .card.full {
  grid-column: 1 / -1;
}

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .card-header h3 {
    font-size: 18px;
    margin: 0;
  }

  .meta {
    font-size: 13px;
    color: #888;
    font-weight: 500;
    margin-left: 6px;
  }

  .controls {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .select {
    border: 1px solid #ddd;
    background: #fafafa;
    padding: 10px 14px;
    border-radius: 12px;
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
  }

  .compare {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #555;
  }

  .list > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid #eee;
    font-size: 14px;
  }

  .list strong {
    font-weight: 600;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .split h4 {
    margin-bottom: 10px;
    font-size: 15px;
    color: #333;
  }

  .hint {
    margin-top: 20px;
    font-size: 14px;
    color: #888;
    text-align: center;
  }

  @media (max-width: 720px) {
    .split {
      grid-template-columns: 1fr;
    }

    .stats-grid{
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .dish-stats-wrapper {
  position: relative;
  grid-column: 1 / -1;
}



.stats-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 40px;
  z-index: 10;
  border-radius: 12px;
}

.stats-overlay-content {
  max-width: 420px;
}

.stats-overlay h3 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 12px;
}

.stats-overlay p {
  font-size: 14px;
  color: #555;
  line-height: 1.5;
}

.chart-scroll {
  overflow-x: auto;
}

.card canvas {
  height: 320px !important;
}
</style>

<%- include("partials/header", { restaurant, active: "stats" }) %>

<div class="container">
<!-- ===== HEADER ===== -->
<h1>Statistiques</h1>
<p class="subtitle">
  Analyse des consultations et performances de votre menu
</p>

<div class="stats-grid">

  <!-- ===== PAGE VIEWS ===== -->
  <div class="card full">
    <div class="card-header">
      <div>
        <h3>
          Consultations du menu
          <span id="totalPageViews" class="meta"></span>
        </h3>
      </div>

      <div class="controls">
        <label class="compare">
          <input type="checkbox" id="compareToggle" />
          Comparer à la période précédente
        </label>

        <select id="periodSelect" class="select">
          <option value="hour">Heure</option>
          <option value="day" selected>Jour</option>
          <option value="month">Mois</option>
          <option value="year">Année</option>
        </select>
      </div>
    </div>

    <div class="chart-scroll">
      <canvas id="pageViewsChart"></canvas>
    </div>
  </div>

  <!-- ===== TOP DISHES ===== -->
  <div class="card">
    <div class="card-header">
      <h3>
        Plats les plus consultés
        <span id="totalDishViews" class="meta"></span>
      </h3>
    </div>

    <div id="topDishes" class="list"></div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h3>
          Scans QR Code
          <span id="totalQrScans" class="meta"></span>
        </h3>
      </div>
  
      <div class="controls">
        <select id="qrPeriodSelect" class="select">
          <option value="hour">Heure</option>
          <option value="day" selected>Jour</option>
          <option value="month">Mois</option>
          <option value="year">Année</option>
        </select>
      </div>
    </div>

    <div class="chart-scroll">
      <canvas id="qrChart"></canvas>
    </div>
  </div>
  

  <!-- ===== DISH TIMELINE ===== -->
<div class="dish-stats-wrapper">

  <% if (!restaurant.features?.advancedDishStats) { %>
    <div class="stats-overlay">
      <div class="stats-overlay-content">
        <h3>Débloquez les statistiques avancées</h3>
        <p>
          Analysez la performance de chaque plat :
          consultations par heure, évolution journalière
          et engagement en réalité augmentée.
          Passez à <strong>l’offre Excellence </strong>pour accéder à l’analyse complète.
        </p>
      </div>
    </div>
  <% } %>

  <div class="card full">
    <div class="card-header">
      <h3>Consultations par plat</h3>

      <div class="controls">
        <select id="dishSelect" class="select"></select>

        <select id="dishPeriodSelect" class="select">
          <option value="hour">Heure</option>
          <option value="day" selected>Jour</option>
          <option value="month">Mois</option>
          <option value="year">Année</option>
        </select>
      </div>
    </div>

    <div class="split">
      <div>
        <h4>Consultations</h4>
        <div class="chart-scroll">
        <canvas id="dishChart"></canvas>
        </div>
      </div>

      <div>
        <h4>Réalité augmentée</h4>
          <div class="chart-scroll">
          <canvas id="dishArChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <p id="dishHint" class="hint">
      Sélectionnez un plat pour afficher ses statistiques
    </p>
  </div>

</div>

</div>
</div>

<script src="/js/admin-stats.js"></script>
