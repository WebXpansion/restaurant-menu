    <div id="success-modal" class="modal-overlay">
      <div class="modal-content">
        <h3>Votre demande a bien été envoyée</h3>
        <p>
          Julien prendra contact avec vous pour discuter de votre projet de réalité augmentée.
        </p>
        <button id="modal-close" class="btn btn-primary">
          Compris
        </button>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
      
        const form = document.getElementById("contact-form");
        const modal = document.getElementById("success-modal");
        const modalClose = document.getElementById("modal-close");
      
        if (!form) return;
      
        form.addEventListener("submit", async function(e) {
          e.preventDefault();
      
          const formData = new FormData(this);
          const data = Object.fromEntries(formData.entries());
      
          try {
            const response = await fetch("/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data)
            });
      
            if (!response.ok) throw new Error("Network error");
      
            const result = await response.json();
      
            if (result.success) {
              modal.classList.add("active");
              this.reset();
            } else {
              alert("Erreur lors de l'envoi.");
            }
      
          } catch (error) {
            console.error(error);
            alert("Une erreur est survenue. Veuillez réessayer.");
          }
        });
      
        // Fermeture via bouton
        if (modalClose) {
          modalClose.addEventListener("click", () => {
            modal.classList.remove("active");
          });
        }
      
        // Fermeture en cliquant en dehors
        if (modal) {
          modal.addEventListener("click", (e) => {
            if (e.target === modal) {
              modal.classList.remove("active");
            }
          });
        }
      
      });
      </script>

<script>
  const hamburger = document.querySelector(".hamburger");
  const mobileMenu = document.querySelector(".mobile-menu");
  
  hamburger.addEventListener("click", () => {
    mobileMenu.classList.toggle("active");
    document.body.style.overflow = 
      mobileMenu.classList.contains("active") ? "hidden" : "auto";
  });
  
  // Fermer au clic sur un lien
  document.querySelectorAll(".mobile-menu a").forEach(link => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("active");
      document.body.style.overflow = "auto";
    });
  });
  </script>

